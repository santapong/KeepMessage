CHANNEL_SECRET=            # LINE Developers > channel > Basic settings
CHANNEL_ACCESS_TOKEN=      # LINE Developers > Messaging API > Channel access token (long-lived)
DESTINATION_USER_ID=       # default recipient for send_line_message
PORT=18081
OFFLINE_REPLY=Claude is offline right now - your message is saved and will be read next session.
API_TOKEN=                   # receiver-side secret protecting /inbox, /ack, and /heartbeat
INBOX_API_URL=               # MCP-side receiver URL, e.g. https://line.example.com
INBOX_API_TOKEN=             # MCP-side copy of API_TOKEN
N8N_FORWARD_URL=          # link-vault: n8n webhook, e.g. https://<pi-host>/webhook/line-link (empty = forwarding off)
N8N_FORWARD_TOKEN=        # shared secret checked by the n8n webhook Header Auth (x-forward-token)

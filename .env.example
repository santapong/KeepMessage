# Copy to .env and fill in real values. Never commit .env.

# ============================================================================
# LINE Messaging API
# Get from: https://developers.line.biz/console/
# ============================================================================
# Channel → Basic settings → Channel secret
LINE_CHANNEL_SECRET=

# Channel → Messaging API tab → Channel access token (v2.1)
LINE_CHANNEL_ACCESS_TOKEN=

# ============================================================================
# Supabase
# Get from: Supabase dashboard → Project Settings → API / Database
# ============================================================================
# Project URL (Settings → API)
SUPABASE_URL=

# service_role key (Settings → API). NEVER use in client-side code.
SUPABASE_SERVICE_KEY=

# Database connection string (Settings → Database → Connection string → URI)
# Use the Transaction Pooler URI (port 6543).
SUPABASE_DB_URL=

# ============================================================================
# MCP-only: defaults
# ============================================================================
# Default recipient for push_message when caller doesn't specify.
# Optional. Find by sending yourself a message and reading sender_user_id from messages table.
DEFAULT_USER_ID=
